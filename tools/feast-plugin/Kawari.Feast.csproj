<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Kawari.Feast</AssemblyName>
    <Version>0.1.0</Version>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(MSBuildThisFileDirectory)..\..\target\dalamud-sdk</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)\Dalamud.dll" Private="false" />
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudLibPath)\FFXIVClientStructs.dll" Private="false" />
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudLibPath)\InteropGenerator.Runtime.dll" Private="false" />
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)\Lumina.dll" Private="false" />
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)\Lumina.Excel.dll" Private="false" />
    <None Update="Kawari.Feast.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
