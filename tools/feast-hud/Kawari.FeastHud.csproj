<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><AssemblyName>Kawari.FeastHud</AssemblyName><Version>0.1.0</Version><DalamudLibPath>$(MSBuildThisFileDirectory)..\..\target\dalamud-sdk</DalamudLibPath></PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../resources/feast-whm-icons.json" LogicalName="FeastWhmIcons.json"/><EmbeddedResource Include="../../resources/feast-actions.json" LogicalName="FeastActions.json"/>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)/Dalamud.dll" Private="false"/>
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll" Private="false"/>
    <Reference Include="FFXIVClientStructs" HintPath="$(DalamudLibPath)/FFXIVClientStructs.dll" Private="false"/>
    <Reference Include="InteropGenerator.Runtime" HintPath="$(DalamudLibPath)/InteropGenerator.Runtime.dll" Private="false"/>
    <Reference Include="Lumina" HintPath="$(DalamudLibPath)/Lumina.dll" Private="false"/>
    <Reference Include="Lumina.Excel" HintPath="$(DalamudLibPath)/Lumina.Excel.dll" Private="false"/>
    <None Update="Kawari.FeastHud.json" CopyToOutputDirectory="PreserveNewest"/>
    <None Update="assets/**" CopyToOutputDirectory="PreserveNewest"/>
    <!-- Local recovered game assets are not distributed or checked into git. -->
    <None Include="../../target/feast-hud-recovery/assets/ui/uld/pvpcolosseumheader.tex" Link="assets/pvpcolosseumheader.tex" CopyToOutputDirectory="PreserveNewest"/>
    <None Include="../../target/feast-hud-recovery/assets/ui/uld/pvpcolosseumgauge.tex" Link="assets/pvpcolosseumgauge.tex" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
</Project>
