       Run with dotnet run, project tools/feast-hud-tests/Tests.csproj. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
  <ItemGroup>
    <Compile Include="../feast-hud/Director/DirectorFrame.cs" Link="DirectorFrame.cs"/>
    <Compile Include="../feast-hud/Director/NativeClient.cs" Link="NativeClient.cs"/>
    <Compile Include="../feast-hud/Actions/FeastJobActions.cs" Link="FeastJobActions.cs"/>
    <Compile Include="../feast-hud/Actions/FeastActionMenu.cs" Link="FeastActionMenu.cs"/>
    <Compile Include="../feast-hud/Actions/FeastResources.cs" Link="FeastResources.cs"/>
    <Compile Include="../feast-hud/Gauges/NativeJobGaugeData.cs" Link="NativeJobGaugeData.cs"/>
    <Compile Include="../feast-hud/Header/MatchHeaderState.cs" Link="MatchHeaderState.cs"/>
    <EmbeddedResource Include="../../resources/feast-actions.json" LogicalName="FeastActions.json"/>
  </ItemGroup>
</Project>
